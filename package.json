{
  "name": "agent-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CrawStudio A.I: plataforma multi-empresa de agentes, automatizaciones y webs con tienda",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "import": "node --env-file-if-exists=.env src/cli-import.ts",
    "mcp": "node --env-file-if-exists=.env src/mcp-stdio.ts",
    "build:datasets": "node scripts/build-dataset-agents.ts",
    "build:catalog": "node scripts/build-catalog.ts",
    "migrate:tenancy": "node --env-file-if-exists=.env scripts/migrate-tenancy.ts",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 'test/**/*.test.ts'"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mariadb": "^3.5.4",
    "yaml": "^2.6.0",
    "zod": "^4.6.7"
  }
}
