# LLM: varios proveedores con API compatible con OpenAI (ver src/llm-providers.ts).
# Pon la clave de los que uses. Una empresa también puede conectar su propia clave
# de DeepSeek o Qwen en Apps (se guarda cifrada y tiene prioridad).
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# Ollama local (sin clave): OLLAMA_BASE_URL=http://localhost:11434/v1 y LLM_MODEL=ollama:qwen3:8b
# Otras URL: DEEPSEEK_BASE_URL, QWEN_BASE_URL (p. ej. el endpoint de China de Model Studio)

# Modelos por tarea, como "proveedor:modelo". Un agente puede fijar el suyo en su
# YAML (model: qwen:qwen-plus).
# Respuestas de los agentes:
LLM_MODEL=deepseek:deepseek-flash
# Clasificar (elegir tema, paso «Clasificar texto»): auto = el más barato con clave
LLM_MODEL_CLASSIFY=auto
# Flujos y asistente de automatización (vacío = LLM_MODEL)
LLM_MODEL_FLOWS=
# Respaldo si el proveedor falla (límite de uso, caída…), en orden
LLM_FALLBACKS=qwen:qwen-plus
# Precios en USD por millón de tokens (los de DeepSeek y Qwen vienen de serie;
# revísalos en la web de cada proveedor). cacheHit es opcional.
# LLM_PRICES={"groq:llama-3.3-70b-versatile":{"input":0.59,"output":0.79}}
# Proveedores extra compatibles con OpenAI:
# LLM_PROVIDERS=[{"key":"kimi","name":"Kimi","baseUrl":"https://api.moonshot.ai/v1","envKey":"KIMI_API_KEY","defaultModel":"kimi-k2"}]

# Voz
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

PORT=3000

# Backend de las respuestas libres: "direct" (DeepSeek desde Agent Studio) o
# "claude-code" (Claude Code con el Claude Agent SDK)
AGENT_BACKEND=direct
# Claude Code: credenciales y modelo (un agente con model: claude-… usa el suyo)
ANTHROPIC_API_KEY=
CLAUDE_CODE_MODEL=claude-opus-5-5
# Opcionales: esfuerzo (low, medium, high, xhigh, max), máximo de pasos por
# respuesta, tiempo máximo y herramientas integradas permitidas (solo en la
# empresa Default; por defecto ninguna, p. ej. WebSearch,WebFetch)
CLAUDE_CODE_EFFORT=
CLAUDE_CODE_MAX_TURNS=10
CLAUDE_CODE_TIMEOUT_MS=180000
CLAUDE_CODE_TOOLS=

# Métricas (los precios de los modelos van en LLM_PRICES, más arriba)
# Coste de voz en USD por cada 1000 caracteres (0 = no contar)
PRICE_TTS_PER_1K_CHARS=0
MONTHLY_BUDGET_USD=20

# Usuarios e inicio de sesión (MariaDB). Sin DB_HOST la app funciona sin login.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=agent_studio
DB_PASSWORD=
DB_NAME=agent_studio
# false = solo se puede crear la primera cuenta (Propietaria de Default y superadmin)
# o registrarse con una invitación
AUTH_ALLOW_SIGNUP=true
# true = quien se registra sin invitación crea su propia empresa (modo SaaS),
# con el plan TENANT_SIGNUP_PLAN (basico, pro o empresa)
TENANT_SELF_SIGNUP=false
TENANT_SIGNUP_PLAN=basico
# true si sirves la app por HTTPS (cookie Secure)
COOKIE_SECURE=false

# Multi-tenant
# Clave maestra para cifrar las credenciales (AES-256-GCM, clave derivada por empresa).
# 32 bytes en base64 o hex: openssl rand -base64 32. Guárdala aparte: sin ella no se
# pueden leer las conexiones. Si falta, se genera una en data/encryption-key.
ENCRYPTION_KEY=
# Caché de permisos y módulos (se vacía al guardar; esto es solo el máximo)
PERMISSION_CACHE_TTL_MS=30000
# Correo para las invitaciones (Resend). Sin esto, la interfaz muestra el enlace.
MAIL_RESEND_API_KEY=
MAIL_FROM=
# Servidores MCP por stdio (ejecutan programas en el servidor): solo en la empresa
# Default salvo que lo permitas para todas
MCP_STDIO_ALL_TENANTS=false
# Clave de API (de tu empresa) para `npm run mcp` por stdio
AGENT_STUDIO_MCP_KEY=
# Opcional: otras carpetas de datos y agentes (p. ej. en otro disco)
# AGENT_STUDIO_DATA_DIR=./data
# AGENT_STUDIO_AGENTS_DIR=./agents
